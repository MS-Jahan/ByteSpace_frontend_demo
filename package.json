    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
